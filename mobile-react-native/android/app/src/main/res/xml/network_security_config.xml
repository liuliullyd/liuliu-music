<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Compatibility choice: necessary direct HTTP stays allowed and unencrypted.
         HTTPS trusts system CAs only. Do not add user anchors/debug overrides. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
